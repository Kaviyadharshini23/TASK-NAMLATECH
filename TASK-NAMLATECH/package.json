{
  "name": "hotelhub-project",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "setup": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "dev": "concurrently -k -n API,WEB \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start:server": "npm --prefix backend run start",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint && npm --prefix backend run lint"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
